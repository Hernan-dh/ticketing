# Usar valores aleatorios alfanuméricos; no publicar este archivo con secretos.
ADMIN_KEY=replace-with-random-operator-key
SERVICE_KEY=replace-with-random-service-key
DB_PASSWORD=replace-with-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
CONTACT_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
TICKET_TOKEN_KEY=replace-with-at-least-32-random-characters
ALLOW_DEMO_PAYMENTS=true
LOG_LEVEL=info
LOG_DIR=logs
